def calculate_market_gap_lookback_days(alpha_csv_path="nvx_production_alpha_matrix.csv"):
    """
    Automated Market Gap & Holiday Detector Core.
    🟢 FIXED: DATE-NORMALISED CLOCKS TO PREVENT TIMEDELTA DRIFT
    """
    import os
    import csv
    from datetime import datetime

    # Isolate today's pure calendar date component, stripping out hour/minute noise
    today_date_only = datetime.now().date()
    default_weekday = datetime.now().weekday() # 0=Monday

    try:
        if os.path.isfile(alpha_csv_path) and os.path.getsize(alpha_csv_path) > 0:
            with open(alpha_csv_path, mode='r') as f:
                reader = csv.reader(f)
                rows = list(reader)
                if len(rows) >= 2:
                    last_recorded_row = rows[-1]
                    # Index 1 is your static "Date" tracking column (Format: YYYY-MM-DD)
                    last_session_date_str = str(last_recorded_row[1]).strip()
                    
                    # Convert to pure date object to ensure perfect 24-hour interval tracking
                    last_session_date = datetime.strptime(last_session_date_str, "%Y-%m-%d").date()
                    
                    # Pure date subtraction calculation returns exact integer days cleanly
                    calendar_gap_days = (today_date_only - last_session_date).days
                    
                    return max(0, calendar_gap_days)
                    
        if default_weekday == 0:
            return 3 # Force 3-day weekend lookback on Monday mornings
        return 1     # Default mid-week baseline lookup spacing
        
    except Exception as gap_calc_fault:
        print(f"⚠️ [GAP CALCULATOR FAULT] Falling back to default spacing: {gap_calc_fault}")
        return 3 if default_weekday == 0 else 1




