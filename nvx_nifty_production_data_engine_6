def update_market_history_buffers(symbol, spot, high, low):
    state = MARKET_HISTORY_STATE[symbol]
    if len(state["closes"]) > 0:
        prev_close = state["closes"][-1]
        change = spot - prev_close
        state["gains"].append(max(0.0, change))
        state["losses"].append(max(0.0, -change))
        tr = max(high - low, abs(high - prev_close), abs(low - prev_close))
        state["true_ranges"].append(tr)
    else:
        state["gains"].append(0.0); state["losses"].append(0.0)
        state["true_ranges"].append(high - low)
    state["closes"].append(spot); state["highs"].append(high); state["lows"].append(low)


