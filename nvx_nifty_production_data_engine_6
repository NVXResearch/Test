        all_topic_scores = []

        for target in market_targets:
            # Connect directly to the sandboxed fetch engine
            news_stream = safe_isolated_news_fetcher(target)

            headlines = [
                story for story in news_stream if story and len(story) > 10
            ]
            if not headlines:
                continue

            sia = SentimentIntensityAnalyzer()
            sia.lexicon.update(
                {
                    "bullish": 2.0,
                    "bearish": -2.0,
                    "rally": 2.5,
                    "crash": -3.0,
                    "slumps": -2.0,
                    "surge": 2.0,
                    "hike": -1.0,
                    "cut": 1.5,
                    'rout': -2.5,
                    'meltdown': -3.0,
                    'breakout': 2.0,
