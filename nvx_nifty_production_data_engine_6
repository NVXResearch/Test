def compute_live_incremental_zscore(symbol, feature_name, current_raw_value):
    """
    Incremental Welford-based Normalization Core.
    Calculates running means, variations, and outputs standardized Z-Scores live 
    every 10 seconds without needing heavy array re-scans [python].
    """
    global GLOBAL_ZSCORE_SCALING_REGISTRY, zscore_lock
    
    # Baseline safety backstop default to avoid breaking empty spreadsheet cells
    zscore_output = 0.0000
    epsilon = 1e-6
    
    with zscore_lock:
        try:
            # Isolate the explicit tracking cell node registry pointer
            stats = GLOBAL_ZSCORE_SCALING_REGISTRY[symbol][feature_name]
            
            stats["count"] += 1
            n = stats["count"]
            
            # Welford's algorithm for updating running mean and variance incrementally
            old_mean = stats["mean"]
            delta = current_raw_value - old_mean
            stats["mean"] += delta / n
            
            new_mean = stats["mean"]
            delta2 = current_raw_value - new_mean
            stats["M2"] += delta * delta2
            
            # Compute standardized standard deviation metrics live on the current pass
            if n >= 2:
                variance = stats["M2"] / (n - 1)
                std_dev = math.sqrt(variance)
                zscore_output = (current_raw_value - stats["mean"]) / (std_dev + epsilon)
                
        except Exception as z_err:
            pass # Guarantees thread processing safety margins
            
    return float(zscore_output)


