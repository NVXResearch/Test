def safe_float(value, fallback=0.0):
    """
    Universal Type-Safe Floating Point Coercion Utility.
    🟢 CRASH IMMUNE: Protects all tracking layers from NoneType and empty strings [1.1].
    """
    if value is None:
        return float(fallback)
    try:
        cleaned_str = str(value).strip().lower()
        if cleaned_str in ["none", "0.0", "0", "", "nan", "null"]:
            return float(fallback)
        return float(value)
    except (ValueError, TypeError):
        return float(fallback)


