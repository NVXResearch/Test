class SmartConnectWithWebSocketV2:
    """
    Official Institutional Angel One V2 Streaming Client Specification.
    Bypasses standard SDK file fragmentation to handle binary ticks natively.
    """
    def __init__(self, auth_token, feed_token, client_code, websocket_url=None):
        self.auth_token = str(auth_token).strip()
        self.feed_token = str(feed_token).strip()
        self.client_code = str(client_code).strip()
        self.websocket_url = websocket_url or "wss://smartapisocket.angelone.in/smart-stream"
        
        # Event subscription stubs matching the required SDK signatures
        self.on_message = None
        self.on_open = None
        self.on_error = None
        self.on_close = None
        self.ws = None

    def connect(self):
        def _run_socket_loop():
            # Build connection headers dynamically to bypass firewall restrictions
            headers = {
                "Authorization": f"Bearer {self.auth_token}",
                "x-feed-token": self.feed_token,
                "x-client-code": self.client_code,
                "User-Agent": "smartapi-python-v2"
            }
            
            # Configure background auto-heartbeat timers matching broker specs
            self.ws = websocket.WebSocketApp(
                self.websocket_url,
                header=headers,
                on_message=self._internal_on_message,
                on_open=self._internal_on_open,
                on_error=self._internal_on_error,
                on_close=self._internal_on_close
            )
            
            # Fire up the loop thread securely using safe TLS 1.3 encryption protocols
            self.ws.run_forever(
                sslopt={"cert_reqs": ssl.CERT_NONE},
                ping_interval=30,
                ping_timeout=10
            )

        threading.Thread(target=_run_socket_loop, name="V2NativeStreamCore", daemon=True).start()

    def _internal_on_open(self, wsapp):
        print("🔓 [WEBSOCKET NATIVE] Connection handshake cleared. Streaming link open.")
        if self.on_open:
            try: self.on_open(wsapp)
            except Exception: pass

    def _internal_on_message(self, wsapp, raw_data):
        if self.on_message:
            try:
                # Unpack and parse binary text payloads seamlessly into your loop caches
                if isinstance(raw_data, str):
                    parsed_node = json.loads(raw_data)
                    self.on_message(wsapp, parsed_node)
            except Exception:
                pass

    def _internal_on_error(self, wsapp, error):
        if self.on_error:
            try: self.on_error(wsapp, error)
            except Exception: pass

    def _internal_on_close(self, wsapp, close_status, close_msg):
        print(f"🔌 [WEBSOCKET NATIVE LINK CLOSED] Tunnel terminated: {close_msg} ({close_status})")
        if self.on_close:
            try: self.on_close(wsapp, close_status, close_msg)
            except Exception: pass

