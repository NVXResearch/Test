            "prev_oi": 0,
            "prev_gwd": 0.0,
        }

    hist = opt_cache["historical_features"]

    # 2. Extract core order book arrays safely via your safe iterator pattern
    buy_layers = raw_msg.get("buy", []) if isinstance(raw_msg, dict) else []
    sell_layers = raw_msg.get("sell", []) if isinstance(raw_msg, dict) else []

    best_bid_node = next((b for b in buy_layers if isinstance(b, dict)), {})
    best_ask_node = next((s for s in sell_layers if isinstance(s, dict)), {})

    best_bid = float(best_bid_node.get("price", current_spot))
    best_ask = float(best_ask_node.get("price", current_spot))

    # =====================================================================
    # 📊 FEATURE ELEMENT CALCULATIONS
    # =====================================================================

    # 1️⃣ WEIGHTED SPREAD: Calculates the distance between the bid and ask prices
    # Standardizes pricing variations across various assets
    weighted_spread = 0.0
    if best_bid > 0.0:
        weighted_spread = round(((best_ask - best_bid) / best_bid) * 10000.0, 4)

    # 2️⃣ BOOK DAMAGE: Tracks the loss of liquidity depth relative to the best bid/ask layers
    # High book damage scores highlight instances where aggressive market orders consume depth
    bid_depth_5 = sum(
        int(b.get("quantity", 0)) for b in buy_layers[:5] if isinstance(b, dict)
    )
    ask_depth_5 = sum(
        int(s.get("quantity", 0)) for s in sell_layers[:5] if isinstance(s, dict)
    )

    book_damage = 0.0
    total_depth_5 = bid_depth_5 + ask_depth_5
    if total_depth_5 > 0:
        book_damage = round((bid_depth_5 - ask_depth_5) / total_depth_5, 4)

    # 3️⃣ HEAVY VOL ACCEL: Measures acceleration spikes in raw execution volume
    # Highlights instances where high-volume institutional orders Hit the market
    current_vol = int(
        raw_msg.get("volume", raw_msg.get("v", raw_msg.get("vol", 0)))
        if isinstance(raw_msg, dict)
        else 0
    )
    prev_vol = int(hist.get("prev_vol", 0))

    heavy_vol_accel = 0.0
    if prev_vol > 0 and current_vol >= prev_vol:
        heavy_vol_accel = float(current_vol - prev_vol)
    elif prev_vol == 0 and current_vol > 0:
        heavy_vol_accel = float(current_vol)

    # 4️⃣ PV DIVERGENCE: Highlights Price-Volume Divergences
    # Positive values flag instances where prices push higher on expanding volumes (Bullish confirmation)
    price_delta = current_spot - float(hist.get("prev_spot", current_spot))
    pv_divergence = round(price_delta * heavy_vol_accel, 4)

    # 5️⃣ OPTION VOL DELTA & COVER VELOCITY: Extracts option surface movements
    # Pulls from your active options tracker variables
    current_oi = int(
        raw_msg.get("oi", raw_msg.get("open_interest", 0))
        if isinstance(raw_msg, dict)
        else 0
    )
    prev_oi = int(hist.get("prev_oi", 0))

    option_vol_delta = float(heavy_vol_accel * 0.15)  # Volatility factor proxy
    cover_velocity = float(current_oi - prev_oi)  # Tracks short covering actions

    # 6️⃣ IV VELOCITY: Tracks standard Implied Volatility velocity vectors
    # Detects sudden expansions in premiums before big macro news drops
    current_iv = float(
        raw_msg.get("iv", 0.0) if isinstance(raw_msg, dict) else 0.0
    )
    prev_iv = float(hist.get("prev_iv", current_iv))
    iv_velocity = round(current_iv - prev_iv, 4)

    # 7️⃣ GAMMA SQUEEZE VELOCITY: Monitors price drifts toward the active Gamma Wall boundary
    # Faster changes track instances where options writers are forced to hedge their positions
    current_gwd = float(opt_cache.get("gamma_wall_distance", 0.0))
    prev_gwd = float(hist.get("prev_gwd", current_gwd))
    gamma_squeeze_velocity = round(prev_gwd - current_gwd, 2)

    # =====================================================================
    # 🔄 HISTORICAL REGISTRY SYNC
    # =====================================================================
    hist["prev_spot"] = current_spot
    hist["prev_vol"] = current_vol
    hist["prev_oi"] = current_oi
    hist["prev_iv"] = current_iv
    hist["prev_gwd"] = current_gwd

    return (
        option_vol_delta,
        weighted_spread,
        heavy_vol_accel,
        iv_velocity,
        cover_velocity,
        gamma_squeeze_velocity,
        book_damage,
        pv_divergence,
    )

