                current_ltp = float(tick_data.get("spot", 0.0))
                
                # Fallback backup check: If websocket has not ticked yet, check your REST cache snapshot fields
                if current_ltp == 0.0:
                    opt_fallback = REST_API_OPTIONS_CACHE.get(symbol, {})
                    current_ltp = float(opt_fallback.get(f"{meta['name']}_LTP", 0.0))
                
                open_reference = float(tick_data.get("open", current_ltp))
                if open_reference == 0.0: 
                    continue
                    
                if current_ltp > 0.0:
                    price_delta = current_ltp - open_reference
                    weight_coefficient = meta["weight"]
                    
                    if price_delta >= 0:
                        advancing_weighted_sum += (price_delta * weight_coefficient)
                    else:
                        declining_weighted_sum += (abs(price_delta) * weight_coefficient)
                        
        if declining_weighted_sum == 0.0:
            return float(1.0 + advancing_weighted_sum)
            
        calculated_breadth_ratio = advancing_weighted_sum / (declining_weighted_sum + epsilon)
        return round(float(calculated_breadth_ratio), 4)
        
    except Exception as matrix_err:
