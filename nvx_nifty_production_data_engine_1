        timestamp_formula = str(latest_row[0]).strip() # Column 1
        date_str          = str(latest_row[1]).strip() # Column 2
        weekday_num       = str(latest_row[2]).strip() # Column 3

                # =====================================================================
        # 🟢 FIXED: UNBOX PRIMITIVE ELEMENTS WITHOUT STRING CONTAINER ARTIFACTS
        # =====================================================================
        # Directly targets the explicit primitive list elements to avoid unhashable set mutations
        if isinstance(latest_row, list):
            raw_time_string = str(latest_row[3]).replace('=', '').replace('"', '').strip() # Pull Time Index 3 directly!
        else:
            raw_time_string = str(latest_row).replace('=', '').replace('"', '').strip()

        time_parts = raw_time_string.split(":")
        if len(time_parts) >= 2:
            hours = time_parts[0]
            minutes = int(time_parts[1])
            
            # Floor round the minutes element cleanly onto its 5-minute boundary multiples
            if timeframe_label == "5-Min":
                minutes = (minutes // 5) * 5
                
            time_str = f"{hours}:{minutes:02d}:00"
        else:
            time_str = raw_time_string
            
        time_str_formula = f'="{time_str}"'
        
        # Inline helper routine to extract numerical arrays safely
        def get_safe_float_list(index_pos):
            float_pool = []
            for row in raw_rows_slice:
                try:
                    val = float(str(row[index_pos]).replace('"', '').replace('=', ''))
                    float_pool.append(val)
                except (ValueError, IndexError): continue
            return float_pool

        # Extract core price variables (Column 6 maps to Underlying_Spot index 5)
        spot_prices_pool = get_safe_float_list(5)
        if not spot_prices_pool: return
        
        open_p, high_p, low_p, close_p = spot_prices_pool[0], max(spot_prices_pool), min(spot_prices_pool), spot_prices_pool[-1]
        
        # Extract core trading metrics from their explicit schema index coordinates
        vol_pool        = get_safe_float_list(13) # Near_Vol index 13
        accumulated_vol = sum(vol_pool) if vol_pool else 0.0
        
        oi_pool = get_safe_float_list(12) # Near_OI index 12
        mean_oi = sum(oi_pool) / len(oi_pool) if oi_pool else 0.0
        
        # Extract mean values for advanced options kinetics parameters
        ce_prem_pool = get_safe_float_list(22)
        mean_ce_prem = sum(ce_prem_pool) / len(ce_prem_pool) if ce_prem_pool else 0.0
        
        ce_iv_pool   = get_safe_float_list(23)
        mean_ce_iv   = sum(ce_iv_pool) / len(ce_iv_pool) if ce_iv_pool else 0.0
        
        pe_prem_pool = get_safe_float_list(26)
        mean_pe_prem = sum(pe_prem_pool) / len(pe_prem_pool) if pe_prem_pool else 0.0
        
        pe_iv_pool   = get_safe_float_list(27)
        mean_pe_iv   = sum(pe_iv_pool) / len(pe_iv_pool) if pe_iv_pool else 0.0
        
        zscore_pool  = get_safe_float_list(43)
        mean_zscore  = sum(zscore_pool) / len(zscore_pool) if zscore_pool else 0.0
        
        variance_pool = get_safe_float_list(47)
        mean_variance = sum(variance_pool) / len(variance_pool) if variance_pool else 0.0

        # =====================================================================
        # 📊 EXTRACT AND TRANSFORM EXTENDED INDICATORS
        # =====================================================================
        rsi_pool  = get_safe_float_list(42) # Index matching RSI column field
        ema_pool  = get_safe_float_list(43) # Index matching EMA price drift field
        atr_pool  = get_safe_float_list(44) # Index matching ATR velocity field
        roc_pool  = get_safe_float_list(45) # Index matching ROC momentum field
        vwap_pool = get_safe_float_list(46) # Index matching VWAP column field
        
