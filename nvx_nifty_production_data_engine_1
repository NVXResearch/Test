            # Unroll and evaluate strike matrices across your running options registers
            for key, metrics in opt_chain.items():
                if not isinstance(metrics, dict) or "strike" not in metrics:
                    continue
                    
                strike_str = str(metrics["strike"])
                
                # Isolate Call Options Max Walls
                if "CE_OI" in metrics:
                    ce_oi = float(metrics["CE_OI"])
                    ce_vol = float(metrics.get("CE_Vol", 0.0))
                    # Combined tracking factor weights volume and open contract metrics concurrently
                    ce_score = ce_oi + (ce_vol * 0.1) 
                    if ce_score > max_ce_oi:
                        max_ce_oi = ce_score
                        calculated_resistance_strike = f"{float(strike_str):.2f}"
                        
                # Isolate Put Options Max Walls
                if "PE_OI" in metrics:
                    pe_oi = float(metrics["PE_OI"])
