    default_res = f"{(int(math.ceil(current_spot / strike_step)) * strike_step):.2f}"
    default_sup = f"{(int(math.floor(current_spot / strike_step)) * strike_step):.2f}"
    
    max_ce_oi = -1.0
    max_pe_oi = -1.0
    
    calculated_resistance_strike = default_res
    calculated_support_strike    = default_sup
    
    try:
        # 🟢 PARSE OPEN INTEREST LAYER TRACKS NATIVELY IN RAM
        # We loop across your live options snapshot keys to find max pools
        with cache_lock:
