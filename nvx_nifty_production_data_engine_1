        mean_atr  = sum(atr_pool) / len(atr_pool) if atr_pool else 0.00
        mean_roc  = sum(roc_pool) / len(roc_pool) if roc_pool else 0.00
        
        # Calculate stationary cross-distance vectors natively
        avg_raw_vwap = sum(vwap_pool) / len(vwap_pool) if vwap_pool else close_p
        
        # 🟢 FIXED: Stripped out curly braces entirely, making the list variable direct and clear! [1.4]
        avg_raw_ema  = sum(ema_pool) / len(ema_pool) if ema_pool else close_p
        
        vwap_distance_vector = (close_p - avg_raw_vwap) / (avg_raw_vwap + 1e-6)
        ema_distance_vector  = (close_p - avg_raw_ema) / (avg_raw_ema + 1e-6)

        # =====================================================================
        # 📂 PERSISTENCE LANE: WRITE STRUCTURAL CANONICAL ROWS TO FILE
        # =====================================================================
        if not os.path.exists(output_file_path):
            with open(output_file_path, "w", encoding="utf-8") as f:
                f.write("Timestamp,Date,Weekday,Time,Symbol,Open,High,Low,Close,Accumulated_Volume,Mean_OI,"
                        "Mean_ATM_CE_Premium,Mean_ATM_CE_IV,Mean_ATM_PE_Premium,Mean_ATM_PE_IV,"
                        "Mean_ZScore,Mean_Vol_Variance,Mean_RSI,Mean_ATR,Mean_ROC,"
                        "VWAP_Distance_Vector,EMA_Distance_Vector\n")
                
        resampled_csv_line = (
            f'{timestamp_formula},{date_str},{weekday_num},{time_str_formula},{symbol},'
            f'{open_p:.2f},{high_p:.2f},{low_p:.2f},{close_p:.2f},{accumulated_vol:.0f},{mean_oi:.0f},'
            f'{mean_ce_prem:.2f},{mean_ce_iv:.2f},{mean_pe_prem:.2f},{mean_pe_iv:.2f},'
            f'{mean_zscore:.4f},{mean_variance:.6f},'
            f'{mean_rsi:.2f},{mean_atr:.4f},{mean_roc:.4f},'
            f'{vwap_distance_vector:.6f},{ema_distance_vector:.6f}'
        )
        
        with open(output_file_path, "a", encoding="utf-8") as f:
            f.write(f"{resampled_csv_line}\n")

        # =====================================================================
        # 🌐 FABRIC LANE: BROADCAST TIMEFRAME OBJECT TO REDIS
        # =====================================================================
        active_redis_instance = None
        for redis_var_name in ["redis_client", "redis_conn", "r_client", "r", "redis"]:
            if redis_var_name in globals() and globals()[redis_var_name] is not None:
                active_redis_instance = globals()[redis_var_name]
                break

        if active_redis_instance is not None:
            try:
                candle_redis_payload = {
                    "open": float(open_p), "high": float(high_p), "low": float(low_p), "close": float(close_p),
                    "accumulated_volume": float(accumulated_vol), "mean_oi": float(mean_oi),
                    "mean_ce_premium": float(mean_ce_prem), "mean_pe_premium": float(mean_pe_premium),
                    "mean_zscore": float(mean_zscore), "moving_vol_variance": float(mean_variance),
                    "mean_rsi": float(mean_rsi), "mean_atr": float(mean_atr), "mean_roc": float(mean_roc),
                    "vwap_distance_vector": float(vwap_distance_vector), "ema_distance_vector": float(ema_distance_vector)
                }
                redis_timeframe_key = f"nvx_features:{symbol}:{timeframe_label.lower()}"
                active_redis_instance.set(redis_timeframe_key, json.dumps(candle_redis_payload))
            except Exception: pass
            
        print(f"📈 [RESAMPLER COMPLETED] Flushed clean {timeframe_label} training candle row with Vector Distance Metrics for {symbol} at {time_str}")
    except Exception as io_err:
        print(f"⚠️ [RESAMPLER FILE WRITE ERROR] Failed to compress timeframe block: {io_err}")

