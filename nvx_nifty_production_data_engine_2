def compute_institutional_oi_walls(symbol, current_spot):
    """
    Options Chain Maximum Concentration Solver.
    Scans the live local options chain registries to isolate the exact strikes
    holding the maximum institutional Open Interest and Volume walls [python].
    """
    global REST_API_OPTIONS_CACHE, cache_lock
    
