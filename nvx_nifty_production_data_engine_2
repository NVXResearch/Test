# If your platform console maps standard print hooks for the warnings, wrap the default sys.stderr stream
class ConsolidatedStreamFilter:
    def __init__(self, original_stream):
        self.stream = original_stream
    def write(self, data):
        if "Attempting to resubscribe/reconnect" in data or "smartWebSocketV2" in data:
            return # Block the text row from showing on your command terminal screen
        self.stream.write(data)
    def flush(self):
        self.stream.flush()

