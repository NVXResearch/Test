def compile_and_flush_candle_matrix(symbol, raw_rows_slice, output_file_path, timeframe_label):
    """
    Type-Safe Candle Consolidation & Multi-Stream Fabric Gateway v5.2.
    Resolves list-string character stringification defects to output clean visual data [python].
    """
    if not raw_rows_slice: return
    
    try:
        # 🟢 DEFINITIVE CORRECTION: Target the list array primitive row node directly [1.4]
        latest_row = raw_rows_slice[-1]
        
        # Pull explicit column values from their index coordinates safely [1.4]
        timestamp_formula = str(latest_row[0]).strip() # Column 1
        date_str          = str(latest_row[1]).strip() # Column 2
        weekday_num       = str(latest_row[2]).strip() # Column 3
        
                # 🟢 THE DEFINITIVE TIME-SERIES TRUNCATION PLUG:
        # Cleans out formula parameters, truncates seconds to zero, 
        # and floors minutes to clean multiples of 5 for macro candles! [1.4]
        raw_time_string = str(latest_row[3]).replace('=', '').replace('"', '').strip()
        time_parts = raw_time_string.split(":")
        
        if len(time_parts) >= 2:
            hours = time_parts[0]
            minutes = int(time_parts[1])
            
            # 🟢 THE MULTIPLE OF 5 LOGIC CELL:
            # If processing a 5-Min candle, mathematically floor round the minutes element! [1.4]
            if timeframe_label == "5-Min":
                minutes = (minutes // 5) * 5
                
            # Reconstruct the string format with zero-padded minutes and absolute zero seconds
            time_str = f"{hours}:{minutes:02d}:00"
        else:
            time_str = raw_time_string
            
        time_str_formula = f'="{time_str}"'

        def get_safe_float_list(index_pos):
            float_pool = []
            for row in raw_rows_slice:
                try:
                    val = float(str(row[index_pos]).replace('"', '').replace('=', ''))
                    float_pool.append(val)
                except (ValueError, IndexError): continue
            return float_pool

        spot_prices_pool = get_safe_float_list(5)
        if not spot_prices_pool: return
        
        open_p, high_p, low_p, close_p = spot_prices_pool[0], max(spot_prices_pool), min(spot_prices_pool), spot_prices_pool[-1]
        
        vol_pool = get_safe_float_list(13)
        accumulated_vol = sum(vol_pool) if vol_pool else 0.0
        
        oi_pool = get_safe_float_list(12)
        mean_oi = sum(oi_pool) / len(oi_pool) if oi_pool else 0.0
        
        ce_prem_pool = get_safe_float_list(22)
        mean_ce_prem = sum(ce_prem_pool) / len(ce_prem_pool) if ce_prem_pool else 0.0
        
        ce_iv_pool = get_safe_float_list(23)
        mean_ce_iv = sum(ce_iv_pool) / len(ce_iv_pool) if ce_iv_pool else 0.0
        
        pe_prem_pool = get_safe_float_list(26)
        mean_pe_prem = sum(pe_prem_pool) / len(pe_prem_pool) if pe_prem_pool else 0.0
        
        pe_iv_pool = get_safe_float_list(27)
        mean_pe_iv = sum(pe_iv_pool) / len(pe_iv_pool) if pe_iv_pool else 0.0
        
        vwap_pool = get_safe_float_list(42)
        mean_vwap = sum(vwap_pool) / len(vwap_pool) if vwap_pool else open_p
        
        zscore_pool = get_safe_float_list(43)
        mean_zscore = sum(zscore_pool) / len(zscore_pool) if zscore_pool else 0.0
        
        variance_pool = get_safe_float_list(47)
        mean_variance = sum(variance_pool) / len(variance_pool) if variance_pool else 0.0
        
        if not os.path.exists(output_file_path):
            with open(output_file_path, "w", encoding="utf-8") as f:
                f.write("Timestamp,Date,Weekday,Time,Symbol,Open,High,Low,Close,Accumulated_Volume,Mean_OI,Mean_ATM_CE_Premium,Mean_ATM_CE_IV,Mean_ATM_PE_Premium,Mean_ATM_PE_IV,Mean_VWAP,Mean_ZScore,Mean_Vol_Variance\n")
                
        resampled_csv_line = (
            f'{timestamp_formula},{date_str},{weekday_num},{time_str_formula},{symbol},'
            f'{open_p:.2f},{high_p:.2f},{low_p:.2f},{close_p:.2f},{accumulated_vol:.0f},{mean_oi:.0f},'
            f'{mean_ce_prem:.2f},{mean_ce_iv:.2f},{mean_pe_prem:.2f},{mean_pe_iv:.2f},'
            f'{mean_vwap:.2f},{mean_zscore:.4f},{mean_variance:.6f}'
        )
        
        with open(output_file_path, "a", encoding="utf-8") as f:
            f.write(f"{resampled_csv_line}\n")

        # 🌐 BROADCAST OBJECTS TO REDIS
        active_redis_instance = None
        for redis_var_name in ["redis_client", "redis_conn", "r_client", "r", "redis"]:
            if redis_var_name in globals() and globals()[redis_var_name] is not None:
                active_redis_instance = globals()[redis_var_name]
                break

        if active_redis_instance is not None:
            try:
                candle_redis_payload = {
                    "open": float(open_p), "high": float(high_p), "low": float(low_p), "close": float(close_p),
                    "accumulated_volume": float(accumulated_vol), "mean_oi": float(mean_oi),
                    "mean_ce_premium": float(mean_ce_prem), "mean_pe_premium": float(mean_pe_premium),
                    "mean_vwap": float(mean_vwap), "mean_zscore": float(mean_zscore),
                    "moving_vol_variance": float(mean_variance)
                }
                redis_timeframe_key = f"nvx_features:{symbol}:{timeframe_label.lower()}"
                active_redis_instance.set(redis_timeframe_key, json.dumps(candle_redis_payload))
            except Exception: pass
            
        print(f"📈 [RESAMPLER COMPLETED] Flushed clean {timeframe_label} training candle row for {symbol} at {time_str}")
    except Exception as io_err:
        print(f"⚠️ [RESAMPLER FILE WRITE ERROR] Failed to compress timeframe block: {io_err}")

