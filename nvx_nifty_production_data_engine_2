            "1594":  {"name": "INFY",       "weight": 0.0640},
            "11536": {"name": "TCS",        "weight": 0.0480}
        }
    }
    
    advancing_weighted_sum = 0.0
    declining_weighted_sum = 0.0
    epsilon = 1e-6
    
