    default_res = f"{(int(math.ceil(current_spot / strike_step)) * strike_step):.2f}"
    default_sup = f"{(int(math.floor(current_spot / strike_step)) * strike_step):.2f}"
    
    max_ce_oi = -1.0
    max_pe_oi = -1.0
    
    calculated_resistance_strike = default_res
    calculated_support_strike    = default_sup
    
    try:
        # 🟢 PARSE OPEN INTEREST LAYER TRACKS NATIVELY IN RAM
        # We loop across your live options snapshot keys to find max pools
        with cache_lock:
            # Check if options chain maps exist for the active asset track
            opt_chain = REST_API_OPTIONS_CACHE.get(symbol, {})
            
            # Unroll and evaluate strike matrices across your running options registers
            for key, metrics in opt_chain.items():
                if not isinstance(metrics, dict) or "strike" not in metrics:
                    continue
                    
                strike_str = str(metrics["strike"])
                
                # Isolate Call Options Max Walls
                if "CE_OI" in metrics:
                    ce_oi = float(metrics["CE_OI"])
                    ce_vol = float(metrics.get("CE_Vol", 0.0))
                    # Combined tracking factor weights volume and open contract metrics concurrently
                    ce_score = ce_oi + (ce_vol * 0.1) 
                    if ce_score > max_ce_oi:
                        max_ce_oi = ce_score
                        calculated_resistance_strike = f"{float(strike_str):.2f}"
                        
                # Isolate Put Options Max Walls
                if "PE_OI" in metrics:
                    pe_oi = float(metrics["PE_OI"])
                    pe_vol = float(metrics.get("PE_Vol", 0.0))
                    pe_score = pe_oi + (pe_vol * 0.1)
                    if pe_score > max_pe_oi:
                        max_pe_oi = pe_score
                        calculated_support_strike = f"{float(strike_str):.2f}"
                        
        return calculated_resistance_strike, calculated_support_strike

    except Exception as ex:
        print(f"⚠️ [WALL RESOLVER ANOMALY] Falling back to default spot parameters: {ex}")
        return default_res, default_sup

