def update_market_history_buffers(symbol, spot, high, low):
    state = MARKET_HISTORY_STATE[symbol]
    if len(state["closes"]) > 0:
        prev_close = state["closes"][-1]
        change = spot - prev_close
        state["gains"].append(max(0.0, change))
        state["losses"].append(max(0.0, -change))
        tr = max(high - low, abs(high - prev_close), abs(low - prev_close))
        state["true_ranges"].append(tr)
    else:
        state["gains"].append(0.0); state["losses"].append(0.0)
        state["true_ranges"].append(high - low)
    state["closes"].append(spot); state["highs"].append(high); state["lows"].append(low)

def calculate_rolling_rsi(symbol):
    state = MARKET_HISTORY_STATE[symbol]
    gains, losses = state["gains"], state["losses"]
    window = LOOKBACK_WINDOWS["RSI"]
    if len(gains) < window: return 50.0
    if state["prev_avg_gain"] is None:
        state["prev_avg_gain"] = sum(list(gains)[-window:]) / window
        state["prev_avg_loss"] = sum(list(losses)[-window:]) / window
    else:
        state["prev_avg_gain"] = ((state["prev_avg_gain"] * (window - 1)) + gains[-1]) / window
        state["prev_avg_loss"] = ((state["prev_avg_loss"] * (window - 1)) + losses[-1]) / window
    if state["prev_avg_loss"] == 0.0: return 100.0 if state["prev_avg_gain"] > 0.0 else 50.0
    rs = state["prev_avg_gain"] / state["prev_avg_loss"]
    return 100.0 - (100.0 / (1.0 + rs))

def calculate_ema_drift(symbol):
    state = MARKET_HISTORY_STATE[symbol]
    closes = state["closes"]
    if len(closes) < LOOKBACK_WINDOWS["EMA"]: return 0.0
    alpha = 2.0 / (LOOKBACK_WINDOWS["EMA"] + 1.0)
    if state["prev_ema"] is None: state["prev_ema"] = sum(list(closes)[-LOOKBACK_WINDOWS["EMA"]:]) / LOOKBACK_WINDOWS["EMA"]
    current_ema = (closes[-1] * alpha) + (state["prev_ema"] * (1.0 - alpha))
    state["prev_ema"] = current_ema
    return ((closes[-1] - current_ema) / current_ema) * 100.0

def calculate_rolling_atr(symbol):
    state = MARKET_HISTORY_STATE[symbol]
    tr_buffer = state["true_ranges"]
    period = LOOKBACK_WINDOWS["ATR"]
    if len(tr_buffer) < period: return tr_buffer[-1] if len(tr_buffer) > 0 else 0.0
    if state["prev_atr"] is None:
        state["prev_atr"] = sum(list(tr_buffer)[-period:]) / period
        return state["prev_atr"]
    current_atr = ((state["prev_atr"] * (period - 1)) + tr_buffer[-1]) / period
    state["prev_atr"] = current_atr
    return current_atr

def calculate_rolling_roc(symbol):
    closes = MARKET_HISTORY_STATE[symbol]["closes"]
    period = LOOKBACK_WINDOWS["ROC"]
    if len(closes) <= period: return 0.0
    historical_close = closes[-(period + 1)]
    if historical_close == 0.0: return 0.0
    return ((closes[-1] - historical_close) / historical_close) * 100.0
def calculate_intraday_vwap_drift(symbol, spot, high, low, live_tick_volume, current_date):
    state = MARKET_HISTORY_STATE[symbol]
    if state["last_trade_date"] != current_date:
        state["cumulative_pv"] = 0.0
        state["cumulative_volume"] = 0.0
        state["last_trade_date"] = current_date
    typical_price = (high + low + spot) / 3.0
    tick_volume_float = float(live_tick_volume)
    if tick_volume_float <= 0.0: 
        tick_volume_float = 1.0  
    state["cumulative_pv"] += (typical_price * tick_volume_float)
    state["cumulative_volume"] += tick_volume_float
    current_vwap = state["cumulative_pv"] / state["cumulative_volume"]
    return ((spot - current_vwap) / current_vwap) * 100.0

def calculate_black_scholes_greeks(spot, strike, iv, expiry_days, is_call=True):
    """
    Ultra-low latency analytical Black-Scholes solver. Replaces heavy scipy constraints
    with raw mathematical math.erf expansions to maintain zero-allocation loop velocity.
    """
    try:
        if expiry_days <= 0: 
            expiry_days = 0.01
        t = expiry_days / 365.0
        r = 0.07  # 7% Risk-free interest rate constant baseline
        sigma = iv / 100.0
        if sigma <= 0: 
            sigma = 0.01

        d1 = (math.log(spot / strike) + (r + (sigma ** 2) / 2.0) * t) / (sigma * math.sqrt(t))
        d2 = d1 - sigma * math.sqrt(t)

        def analytical_cdf(x): 
            return (1.0 + math.erf(x / math.sqrt(2.0))) / 2.0
        def analytical_pdf(x): 
            return math.exp(-(x ** 2) / 2.0) / math.sqrt(2.0 * math.pi)

        pdf_d1 = analytical_pdf(d1)
        cdf_d1 = analytical_cdf(d1)
        cdf_d2 = analytical_cdf(d2)

        if is_call:
            delta = cdf_d1
            theta = (- (spot * pdf_d1 * sigma) / (2.0 * math.sqrt(t)) - r * strike * math.exp(-r * t) * cdf_d2) / 365.0
        else:
            delta = cdf_d1 - 1.0
            theta = (- (spot * pdf_d1 * sigma) / (2.0 * math.sqrt(t)) + r * strike * math.exp(-r * t) * analytical_cdf(-d2)) / 365.0

        gamma = pdf_d1 / (spot * sigma * math.sqrt(t))
        return round(float(delta), 4), round(float(theta), 2), round(float(gamma), 6)
    except Exception:
        return (0.5000, -12.00, 0.002500) if is_call else (-0.5000, -12.00, 0.002500)

