    current_time_epoch = time.time()
    
    # Standard normal cumulative distribution function (CNF) helper using native math.erf
    # This completely replaces the heavy scipy library dependencies to maintain loop speed
    def normal_cdf(x):
        return 0.5 * (1.0 + math.erf(x / math.sqrt(2.0)))

    # Sweep across your three primary asset tracking lanes symmetrically
    for symbol in ["NIFTY", "BANKNIFTY", "SENSEX"]:
        try:
            # A. Determine the current underlying spot index price boundary
            if symbol == "NIFTY":
                spot = spot_close if spot_close > 0 else 24345.00
            elif symbol == "BANKNIFTY":
                spot = banknifty_close if banknifty_close > 0 else 57450.00
            else:
                spot = sensex_close if sensex_close > 0 else 77840.00

            # B. Extract the dynamic strike parameters and IV metrics from memory caches
            with ws_cache_lock:
                ws_node = LATEST_WS_TICK_CACHE.get(symbol, {})
                ce_iv = float(ws_node.get("ce_iv", 15.00)) / 100.0   # Convert percentage to decimal format
                pe_iv = float(ws_node.get("pe_iv", 15.50)) / 100.0
                ce_ltp = float(ws_node.get("ce_ltp", 0.00))
                pe_ltp = float(ws_node.get("pe_ltp", 0.00))

            strike = float(TOKEN_REGISTRY_RAM[symbol].get("active_strike", spot))
            if strike <= 0:
                strike = spot

            # C. Dynamic Expiry Time-to-Maturity Calculation (Annualised 'T')
            # Reads the true calendar target and calculates precise partial day trading decay fraction
            try:
                exp_str = str(TOKEN_REGISTRY_RAM[symbol].get("expiry_date", datetime.now().strftime("%Y-%m-%d")))
                expiry_dt = datetime.strptime(exp_str, "%Y-%m-%d").replace(hour=15, minute=30, second=0)
                time_delta_seconds = (expiry_dt - datetime.now()).total_seconds()
                # Floor time parameter to a micro-fraction safety minimum limit to avoid division by zero crashes
                t_years = max(time_delta_seconds / (365.0 * 24.0 * 3600.0), 0.0001)
            except Exception:
                t_years = 0.0114  # Safe standard fallback layout placeholder (approx 4 calendar days)

            risk_free_rate = 0.07  # Fixed standard 7% Indian sovereign yield macro anchor

            # =====================================================================
            # 🧮 BLACK-SCHOLES MATHEMATICAL SOLVER PIPELINE (CALL OPTIONS)
            # =====================================================================
            ce_delta, ce_theta = 0.5000, -10.00  # Baseline fallbacks
            if ce_iv > 0:
                d1_ce = (math.log(spot / strike) + (risk_free_rate + (ce_iv ** 2) / 2.0) * t_years) / (ce_iv * math.sqrt(t_years))
                d2_ce = d1_ce - ce_iv * math.sqrt(t_years)
                
                # Analytical Greek Derivatives Formulas
                ce_delta = normal_cdf(d1_ce)
                
                # Annualised Theta formulation unrolled natively down to 1 trading calendar day step metrics
                ce_theta_annual = -((spot * ce_iv * math.exp(-d1_ce**2 / 2.0)) / (2.0 * math.sqrt(2.0 * math.pi * t_years))) - \
                                  (risk_free_rate * strike * math.exp(-risk_free_rate * t_years) * normal_cdf(d2_ce))
                ce_theta = ce_theta_annual / 365.0  # Daily rate-of-change degradation decay component

            # =====================================================================
            # 🧮 BLACK-SCHOLES MATHEMATICAL SOLVER PIPELINE (PUT OPTIONS)
            # =====================================================================
            pe_delta, pe_theta = -0.5000, -10.00
            if pe_iv > 0:
                d1_pe = (math.log(spot / strike) + (risk_free_rate + (pe_iv ** 2) / 2.0) * t_years) / (pe_iv * math.sqrt(t_years))
                d2_pe = d1_pe - pe_iv * math.sqrt(t_years)
                
                pe_delta = normal_cdf(d1_pe) - 1.0   # Put delta is mathematically bounded negative
                
                pe_theta_annual = -((spot * pe_iv * math.exp(-d1_pe**2 / 2.0)) / (2.0 * math.sqrt(2.0 * math.pi * t_years))) + \
                                  (risk_free_rate * strike * math.exp(-risk_free_rate * t_years) * normal_cdf(-d2_pe))
                pe_theta = pe_theta_annual / 365.0

            # =====================================================================
            # 📊 HIGH-FREQUENCY VOLATILITY TRACKERS (VIX VELOCITY VECTOR)
            # =====================================================================
            with cache_lock:
                opt = REST_API_OPTIONS_CACHE[symbol]
                prev_vix = float(opt.get("last_processed_vix", vix_close))
                
                vix_delta_velocity = 0.0000
                if prev_vix > 0.0 and vix_close > 0.0:
                    vix_delta_velocity = vix_close - prev_vix
                    
                opt["last_processed_vix"] = vix_close
                skew_velocity = (ce_iv * 100.0) - (pe_iv * 100.0)  # Skew tracking spreads vector

                # 🟢 STEP 4: WRITE CALCULATED QUANT VALS THREAD-SAFE STRAIGHT TO REST OPTIONS CACHE
                opt.update({
                    "CE_Premium": float(ce_ltp),
                    "CE_IV": float(ce_iv * 100.0),
                    "CE_Delta": float(ce_delta),
                    "CE_Theta": float(ce_theta),
                    
                    "PE_Premium": float(pe_ltp),
                    "PE_IV": float(pe_iv * 100.0),
                    "PE_Delta": float(pe_delta),
                    "PE_Theta": float(pe_theta),
                    
                    "VIX_Velocity": float(vix_delta_velocity),
                    "Skew_Velocity": float(skew_velocity),
                    "ATM_Strike": int(strike)
                })
                
        except Exception as Greek_calc_err:
            print(f"⚠️ [GREEKS CALCULATOR ANOMALY] Failed optimization pass for {symbol}: {Greek_calc_err}")

